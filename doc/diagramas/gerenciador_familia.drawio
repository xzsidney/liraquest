          <mxGeometry x="40" y="139" width="700" height="34" as="geometry" />
        </mxCell>
        <mxCell id="t3_uc01_body" value="&lt;b&gt;Fluxo Principal:&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. O usuário acessa a &lt;b&gt;Tela Home&lt;/b&gt; (boas-vindas e botão &lt;b&gt;&quot;Entrar&quot;&lt;/b&gt;).&lt;br&gt;&lt;br&gt;2. Na &lt;b&gt;Tela de Login&lt;/b&gt;, informa e-mail/usuário e senha.&lt;br&gt;&lt;br&gt;3. O sistema valida as credenciais, identifica o &lt;code&gt;tipo_perfil&lt;/code&gt; e redireciona automaticamente para a tela correspondente (Admin, Pai ou Filho).&lt;br&gt;&lt;br&gt;&lt;b&gt;Fluxo Alternativo (Erro):&lt;/b&gt; Caso as credenciais sejam inválidas, exibe mensagem de erro e retorna para a Tela de Login." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#0F172A;strokeColor=none;fillColor=none;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="58" y="186" width="664" height="248" as="geometry" />
        </mxCell>

        <!-- Card UC02 -->
        <mxCell id="t3_uc02_box" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FEF9E7;strokeColor=#1E293B;strokeWidth=2;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="820" y="95" width="700" height="355" as="geometry" />
        </mxCell>
        <mxCell id="t3_uc02_hdr" value="UC02 — CRUD de Usuários (Foco no Perfil Administrador)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FDE047;strokeColor=#1E293B;strokeWidth=2;fontStyle=1;fontSize=15;fontColor=#0F172A;align=left;spacingLeft=16;" vertex="1" parent="1">
          <mxGeometry x="820" y="95" width="700" height="44" as="geometry" />
        </mxCell>
        <mxCell id="t3_uc02_sub" value="&lt;b&gt;Ator Principal:&lt;/b&gt; Administrador (e parcialmente o Pai, dentro do próprio núcleo familiar)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#1E293B;strokeWidth=1;fontSize=12;fontColor=#334155;align=left;spacingLeft=16;" vertex="1" parent="1">
          <mxGeometry x="820" y="139" width="700" height="34" as="geometry" />
        </mxCell>
        <mxCell id="t3_uc02_body" value="&lt;b&gt;Funcionalidades na Tela do Admin:&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Create (Criar):&lt;/b&gt; Cadastrar novos usuários definindo Nome, E-mail, Senha e Perfil (Admin, Pai ou Filho) e vincular a uma família.&lt;br&gt;&lt;br&gt;• &lt;b&gt;Read (Ler/Listar):&lt;/b&gt; Visualizar lista de todos os usuários cadastrados com filtro por família ou perfil.&lt;br&gt;&lt;br&gt;• &lt;b&gt;Update (Atualizar):&lt;/b&gt; Alterar dados cadastrais, redefinir senhas ou mudar o tipo de perfil.&lt;br&gt;&lt;br&gt;• &lt;b&gt;Delete (Excluir):&lt;/b&gt; Desativar ou remover um usuário do sistema." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#0F172A;strokeColor=none;fillColor=none;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="838" y="186" width="664" height="248" as="geometry" />
        </mxCell>

        <!-- Card UC03 -->
        <mxCell id="t3_uc03_box" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FEF9E7;strokeColor=#1E293B;strokeWidth=2;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="510" width="700" height="355" as="geometry" />
        </mxCell>
        <mxCell id="t3_uc03_hdr" value="UC03 — Área de Trabalho: Perfil Pai / Responsável" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FDE047;strokeColor=#1E293B;strokeWidth=2;fontStyle=1;fontSize=15;fontColor=#0F172A;align=left;spacingLeft=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="510" width="700" height="44" as="geometry" />
        </mxCell>
        <mxCell id="t3_uc03_sub" value="&lt;b&gt;Tela:&lt;/b&gt; Dashboard de Gestão Familiar  •  &lt;b&gt;Ator:&lt;/b&gt; Pai / Responsável" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#1E293B;strokeWidth=1;fontSize=12;fontColor=#334155;align=left;spacingLeft=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="554" width="700" height="34" as="geometry" />
        </mxCell>
        <mxCell id="t3_uc03_body" value="&lt;b&gt;O que faz:&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Criar Tarefas:&lt;/b&gt; Cria tarefas domésticas ou escolares atribuídas a um filho específico.&lt;br&gt;&lt;br&gt;• &lt;b&gt;Validar e Aprovar:&lt;/b&gt; Recebe notificações quando o filho marca uma tarefa como feita e clica em &lt;b&gt;&quot;Aprovar&quot;&lt;/b&gt;.&lt;br&gt;&lt;br&gt;• &lt;b&gt;Recompensas e Mesada:&lt;/b&gt; Define regras de pontos ou valor da mesada, além de gerenciar o catálogo de recompensas da família.&lt;br&gt;&lt;br&gt;• &lt;b&gt;Consulta Restrita:&lt;/b&gt; Consulta os usuários pertencentes apenas ao próprio núcleo familiar." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#0F172A;strokeColor=none;fillColor=none;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="58" y="601" width="664" height="248" as="geometry" />
        </mxCell>

        <!-- Card UC04 -->
        <mxCell id="t3_uc04_box" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FEF9E7;strokeColor=#1E293B;strokeWidth=2;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="820" y="510" width="700" height="355" as="geometry" />
        </mxCell>
        <mxCell id="t3_uc04_hdr" value="UC04 — Área de Trabalho: Perfil Filho" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FDE047;strokeColor=#1E293B;strokeWidth=2;fontStyle=1;fontSize=15;fontColor=#0F172A;align=left;spacingLeft=16;" vertex="1" parent="1">
          <mxGeometry x="820" y="510" width="700" height="44" as="geometry" />
        </mxCell>
        <mxCell id="t3_uc04_sub" value="&lt;b&gt;Tela:&lt;/b&gt; Dashboard Gamificado / Minhas Missões  •  &lt;b&gt;Ator:&lt;/b&gt; Filho" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#1E293B;strokeWidth=1;fontSize=12;fontColor=#334155;align=left;spacingLeft=16;" vertex="1" parent="1">
          <mxGeometry x="820" y="554" width="700" height="34" as="geometry" />
        </mxCell>
        <mxCell id="t3_uc04_body" value="&lt;b&gt;O que faz:&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Visualizar Tarefas:&lt;/b&gt; Visualiza a lista de tarefas do dia/semana com prazos e pontuação.&lt;br&gt;&lt;br&gt;• &lt;b&gt;Concluir Missões:&lt;/b&gt; Envia comprovação (ou marca como concluída) para avaliação dos pais.&lt;br&gt;&lt;br&gt;• &lt;b&gt;Saldo e Resgates:&lt;/b&gt; Acompanha seu saldo de pontos/mesada e troca por recompensas cadastradas pelos pais." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#0F172A;strokeColor=none;fillColor=none;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="838" y="601" width="664" height="248" as="geometry" />
        </mxCell>

        <!-- Setas de Roteamento entre UC01 e UC02–UC04 -->
        <mxCell id="t3_e_uc01_uc02" value="Perfil: Admin" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;dashPattern=6 4;endArrow=block;endFill=1;strokeColor=#7E22CE;strokeWidth=2;fontColor=#6B21A8;fontStyle=1;fontSize=11;labelBackgroundColor=#FAFAFA;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t3_uc01_box" target="t3_uc02_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="t3_e_uc01_uc03" value="Perfil: Pai" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;dashPattern=6 4;endArrow=block;endFill=1;strokeColor=#1D4ED8;strokeWidth=2;fontColor=#1E40AF;fontStyle=1;fontSize=11;labelBackgroundColor=#FAFAFA;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="t3_uc01_box" target="t3_uc03_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="t3_e_uc01_uc04" value="Perfil: Filho" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;dashPattern=6 4;endArrow=block;endFill=1;strokeColor=#15803D;strokeWidth=2;fontColor=#166534;fontStyle=1;fontSize=11;labelBackgroundColor=#FAFAFA;exitX=0.85;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="t3_uc01_box" target="t3_uc04_box">
          <mxGeometry x="0.1" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="635" y="480" />
              <mxPoint x="1170" y="480" />
            </Array>
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
