; English

[SceneDef]
spr = ending.sff
startscene = 0         ;Starting scene number (for debugging)

;------------------------------------
[Scene 0]
; Fade
fadein.time = 30
fadein.col = 255,255,255     ;Use 255,255,255 for white-fade
fadeout.time = 0
fadeout.col = 240,200,50
; Screen color
clearcolor = 50,50,255
; Overlay Anims (from 0 to 9)
layerall.pos = 0,0   ;Default position for all layers
layer0.anim =  0       ;Anim action number
layer0.offset = 0,0    ;Position offset
layer0.starttime = 0   ;Time to start display
layer1.anim =  30
layer1.offset = 0,0
; Music
bgm = Spider1.mid        ;Name of music file to play
bgm.loop = 1
; Total time
end.time = 1350

;------------------------------------
[Scene 1]
; Fade
fadein.time = 70       ;Time to take for fading in
fadein.col = 255,255,255     ;Use 255,255,255 for white-fade
fadeout.time = 70
fadeout.col = 255,255,255
; Screen color
clearcolor = 50,50,255
; Overlay Anims (from 0 to 9)
layerall.pos = -25,0   ;Default position for all layers
layer0.anim =  0       ;Anim action number
layer0.offset = 0,0    ;Position offset
layer0.starttime = 0   ;Time to start display
layer1.anim =  13
layer1.offset = 120,190
layer2.anim =  40
layer2.offset = 51,11
; Total time
end.time = 171

;------------------------------------
[Scene 2]
; Fade
fadein.time = 40
fadein.col = 240,200,50
fadeout.time = 0
fadeout.col = 0,0,0
; Screen color
; The previous clearcolor value is carried over by default
; Overlay Anims (from 0 to 9)
; The previous layerall.pos value is carried over by default
layerall.pos = -40,-10   ;Default position for all layers
layer0.anim =  20       ;Anim action number
layer0.offset = 0,0   ;Position offset
layer0.starttime = 0   ;Time to start display
layer1.anim =  50
layer1.offset = 0,0
; Total time
end.time = 200



