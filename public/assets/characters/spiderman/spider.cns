; stand_x  (weak punch)
[statedef 200]
type    = s                      ;state-type: s-stanD, c-crouch, a-air, l-liedown
movetype= a                      ;move-type: a-attack, i-idle, h-gethit
physics = s                     
juggle  = 5
velset = 0,0                    
ctrl = 0
anim = 200
poweradd = 27                    ;power to add (def: 0)

[state 200, 1]
type = playsnd                   ; weak punch swoosh
trigger1 = time = 0
value = 0,1

[state 200, 2]
type = playsnd                   ; spidey's voice "ha"
trigger1 = time = 1
value = 1, 0

[state 200, 3]
type = hitdef
trigger1 = animelem = 2
attr = s, na
damage = 23
animtype = light
guarDFlag = ma                    ;flags on how move is to be guarded against
hitflag = mf
priority = 3, hit
pausetime = 8,8
numhits = 1
sparkno = s2800
sparkxy = -10,-61
guard.sparkno = s2500
hitsound = s5,0
guardsound = s6,0
ground.type = high
ground.slidetime = 10             ;time that the victim slides back
ground.hittime  = 11           ;time victim is in hit state
ground.velocity = -5.4               ;velocity at which victim is pushed
guard.slidetime = 15              ;values For guarded attack (def: ground.slidetime)
guard.hittime  = 15              ; (def: ground.hittime)
guard.velocity = -8                ; (def: ground.velocity)
; guard.ctrltime = 7    
airguard.velocity = -6    ;guard velocity in air (def: (air.xvel*1.5, air.yvel/2))
; airguard.ctrltime = 7          ;time to regain control after air guard (def: ground.ctrltime)
air.velocity = -6,-1.7           ;x-velocity at which victim is pusheD,
                                 ;y-velocity at which victim is pushed
air.type = low
air.hittime = 16                 
; attack.width = 3, 3              ;override Default attack width
; Fall.damage = 0                  ;damage opponent takes on Fall
; Fall.velocity = n/a,-4.5         ;x, y-velocity after bouncing off ground
; Fall.animtype = back             ;animation type For Falling people (def: back)


[state 200, 7]
type = changestate
trigger1 = animtime = 0
value = 0
ctrl = 1

