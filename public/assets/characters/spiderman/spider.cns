yaccel           = .59        
stand.friction   = .83  
crouch.friction  = .79 

; lose (time over)
[statedef 170]
type = s
ctrl = 0
anim = 170
velset = 0,0,0

[state 170, 2]   ; what happened?
type = playsnd
trigger1 = time = 5
value = 3, 3

[state 170, 1]
type = nothitby
trigger1 = time >= 0
value = sca
time = 1

;---------------------------------------------------------------------------
; win
[statedef 180]
type = s

[state 180, 1]            
type = assertspecial     
trigger1 = time = [0,200]
flag = roundnotover

[state 180, 2]
type = changestate
trigger1 = time = 0
trigger1 = winko= 0
value = 183

[state 180, 3]            ; randomly choose win type 1 or 2
type = varrandom         
trigger1 = time = 0
v = 1
range = 0,9

[state 180, 4]
type = changestate
trigger1 = time = 0
trigger1 = var(1) = [0,4]
;trigger1 = Frontedgedist < 250
;trigger1 = backedgedist > 50
value = 182

[state 180, 5]
type = changestate
trigger1 = time = 0
value = 181

