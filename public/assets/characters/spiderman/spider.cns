; intro 1 spiderman hangs Down with web
[statedef 191]
type = s
ctrl = 0
anim = 190
velset = 0,0,0

[state 191,1]  ; global variable (for something else regarding sound Fx and the cocoon...)
type = varset  ; i'm almost 100% sure you won't need to Use this For your characters...
trigger1 = var(8) !=0
v = 8
value = 0

[state 191, 1]            ; randomly choose intro 1 or 2
type = varrandom          ; all thanks to neogouki !
trigger1 = time = 0
v = 2
range = 0,9

[state 191, 2]
type = changestate
trigger1 = time = 0
trigger1 = var(2) = [0,4]
value = 192

[state 191, 3]             ; intro Declaration
type = assertspecial
trigger1 = time = [0,90]
flag = intro

[state 191, 4]   ; "showtime" sound wav
type = playsnd
trigger1 = time = 60
value = 3, 1

[state 191, 5]            ; activate spotlight
type = projectile         
trigger1 = time = 0      
projanim = 192
offset = 0,0
projremovetime = 48

[state 191, 6]            ; activate web
type = projectile
trigger1 = time = 111
projanim = 191
offset = 0,8
projremovetime = 6

[state 191, 5]            ; land on ground animation
type = changeanim
trigger1 = time = 155
value = 47

[state 191, 6]            ; idle standing animation
