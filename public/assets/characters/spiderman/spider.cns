poweradd = 80                    ;power to add (def: 0)

[state 202, 1]
type = playsnd  ; Fierce punch swoosh
trigger1 = time = 0
value = 0,3

[state 202, 2]
type = playsnd  ; spidey's voice "hwa"
trigger1 = time = 1
value = 1, 2

[state 202, 3]
type = hitdef
trigger1 = animelem = 2
trigger1 = p2stateno != 5030
trigger1 = p2stateno != 5035
trigger2 = p2stateno = 5040
trigger2 = time > 200
attr = s, na                     ;attribute: standing, normal attack
damage    = 63                  
animtype = heavy               ;anim type: light, medium, heavy, back (def: light)
;getpower = 30,15                 ;power to get on hit, on guard
;                                 ;(def hit: 0)  (def guard: 1/2 of hit power)
;givepower = 15,8                 ;power to give opponent on hit, on guard
;                                 ;(def hit: 0)  (def guard: 1/2 of hit power)
guarDFlag = ma                   ;flags on how move is to be guarded against
hitflag = maf                    ;flags of conditions that move can hit
priority = 4, hit                ;attack priority: 0 (least) to 7 (most), 4 Default
                                 ;hit/miss/Dodge type (def: hit)
pausetime = 8,8                  ;time attacker pauses, time victim shakes
numhits = 1                      ;number of hits to count as (def: 1)
sparkno = s2800                   ;spark image group and no (def: set above)
sparkxy = -20,-80                ;x-offset For the "hit spark" rel. to p2,
guard.sparkno = s2500              
hitsound = s5,2
guardsound = s6,0
ground.type = high    ;type: high, low, trip (def: normal)
ground.slidetime = 10             ;time that the victim slides back
ground.hittime  = 12             ;time victim is in hit state
ground.velocity = -7.2,-2                ;velocity at which victim is pushed
guard.slidetime = 20
guard.hittime  = 20              ; (def: ground.hittime)
guard.velocity = -11  
airguard.velocity = -6  
; airguard.ctrltime = 7
air.juggle = 15
air.velocity = -7.2, 2
air.type = low
air.hittime = 40                  ;time before oppoment regains control in air
; attack.width = 3, 3              ;override Default attack width
;fall.velocity = 0,10         ;x, y-velocity after bouncing off ground
fall.animtype = heavy    ;animation type For Falling people (def: back)
down.hittime = 1
down.velocity = 0,0
p2stateno = 250

[state 202, 7]
type = changestate
trigger1 = animtime = 0
value = 0
ctrl = 1

;the Following code was taken From mystic blase´s captain america, so all the 
;credit goes to him.
;---------------------------------------------------------------------------
; hitg_shake (vs-style hitbounce)
[statedef 250]
type    = s
movetype= h
physics = n
velset = 0,0

[state 250, 1] ;anim For hit_light to hit_hard
type = changeanim
trigger1 = time = 0
value = 5012

[state 250, nothitby]
type = nothitby
trigger1 = time >= 0
value = sca
time = 1

[state 250, 4] ;freeze anim
type = changeanim
trigger1 = time > 0
value = anim

[state 250, 5] ;state type gets set to aerial if getting hit Up
type = statetypeset
trigger1 = time = 0
trigger1 = gethitvar(yvel) != 0 && gethitvar(fall)
trigger2 = pos y != 0
type = a

[state 250, 7]
type = changestate
trigger1 = hitshakeover
value = 251

[state 250, Ffb light]
type = ForcefeeDBack
trigger1 = anim = 5000
trigger2 = anim = 5010
persistent = 0
time = 6
waveform = square

[state 250, Ffb medium]
type = ForcefeeDBack
trigger1 = anim = 5001
trigger2 = anim = 5011
persistent = 0
time = 8
waveform = sinesquare
ampl = 110,-1,-.3

[state 250, Ffb hard]
type = ForcefeeDBack
trigger1 = anim = 5012
trigger2 = anim = 5002
trigger3 = anim = 5030
persistent = 0
time = 15
waveform = sinesquare
ampl = 140

;---------------------------------------------------------------------------
; hita_up (initial going Up) (vs-style hitbounce)
[statedef 251]
type    = a
movetype= h
physics = n
anim = 5030
ctrl = 0

[state 251, nothitby]
type = nothitby
trigger1 = time = 0
value = sca
time = 10

[state 251, 1]
type = veladd;gravity
trigger1 = 1
y = gethitvar(yaccel)

[state 251, 2]
type = hitvelset
trigger1 = time = 0
x = 1
y = 1

[state 251, 5]
type = changestate
trigger1 = (animtime = 0) || (time = 10)
value = 252 ;hita_up (transition)

;---------------------------------------------------------------------------
; hita_up_t (transition) (vs-style hitbounce)
[statedef 252]
type    = a
movetype= h
physics = n

[state 252, 1]
type = changeanim
trigger1 = time = 0
trigger1 = selfanimexist(5035)
trigger1 = anim != [5051,5059] ;not if in hit Up anim
trigger1 = anim != 5090 ;not if hit off ground anim
value = 5035

[state 252, 2]
type = veladd
trigger1 = 1
y = gethitvar(yaccel)

[state 252, 4]
type = changestate
trigger1 = hitover  ;hit is over
trigger2 = animtime = 0 ;anim is over
trigger3 = time = 0     ;no transition anim
trigger3 = anim != 5035 ;.
value = 253 ;hita_fall

;---------------------------------------------------------------------------
; hita_fall (knocked Up, Falling) (vs-style hitbounce)
[statedef 253]
type    = a
movetype= h
physics = n

[state 253, 1] ;change anim when Done with transition
type = changeanim
trigger1 = animtime = 0
trigger1 = anim = 5035
trigger2 = time = 0     ;if no transition anim
trigger2 = anim != 5035
trigger2 = (anim != [5051, 5059]) && (anim != [5061, 5069])
trigger2 = anim != 5090 ;not if hit off ground anim
value = 5050

[state 253, 2] ;coming Down anim
type = changeanim
trigger1 = anim = [5050,5059]
trigger1 = vel y >= ifelse(anim = 5050, 1, -2)
trigger1 = selfanimexist(anim+10)
value = anim+10
persistent = 0

[state 253, 3] ;gravity
type = veladd
trigger1 = 1
y = gethitvar(yaccel)

[state 253, 6]
type = changestate
triggerall = alive = 1
trigger1 = vel y > 0
trigger1 = pos y >= ifelse((anim = [5051,5059]) || (anim = [5061,5069]), 0, 25)
value = 254 ;hit_bounce

[state 253, selfstate]
type = selfstate
triggerall = alive = 0
trigger1 = vel y > 0
trigger1 = pos y >= ifelse((anim = [5051,5059]) || (anim = [5061,5069]), 0, 25)
value = 5101 ;hit_bounce

;---------------------------------------------------------------------------
; hit_bounce (hit ground) (vs-style hitbounce)
[statedef 254]
type    = l
movetype= h
physics = n

[state 254, 1]
type = velset
trigger1 = time = 0
trigger1 = gethitvar(fall.yvel) = 0
trigger1 = vel x > 1
x = 1

[state 254, envshake]
type = envshake
trigger1 = time = 0
time = 20
freq = 60
ampl = -5

[state 254, var] ;save Fall velocity
type = varset
trigger1 = time = 0
sysvar(1) = Floor(vel y)

[state 254, 2] ;hit ground anim (normal)
type = changeanim
triggerall = time = 0
trigger1 = (anim != [5051,5059]) && (anim != [5061,5069])
trigger2 = !selfanimexist(5100 + (anim % 10))
value = 5100

[state 254, 3] ;hit ground anim (for hit Up)
type = changeanim
trigger1 = time = 0
trigger1 = (anim = [5051,5059]) || (anim = [5061,5069])
trigger1 = selfanimexist(5100 + (anim % 10))
value = 5100 + (anim % 10)

[state 254, 4]
type = posset
trigger1 = time = 0
y = 0

[state 254, 5]
type = velset
trigger1 = time = 0
y = 0

[state 254, 6] ;reduce speed
type = velmul
trigger1 = time = 0
x = 0.75

[state 254, 10]
type = playsnd
trigger1 = time = 1
value = F7, 2;(sysvar(1) > 5) + (sysvar(1) > 14)

[state 254, 11]
type = posfreeze
trigger1 = 1

[state 254, 12]
type = changestate
trigger1 = animtime = 0
value = 255

[state 254, 13]
type = ForcefeeDBack
trigger1 = time = 0
waveform = sinesquare
ampl = 128,-3,-.2,.005
time = 20

[state 254, 14]
type = explod
trigger1 = time = 1
anim = F62
postype = p1
pos = 0,0
bindtime = 4
sprpriority = 2
ownpal = 1

