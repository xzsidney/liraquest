yscale            = 1           
ground.back       = 28     
ground.front      = 30    
air.back          = 28   
air.front         = 22   
z.width           = 3          
height            = 55	  
attack.width      = 4,4   
attack.dist       = 160 
proj.attack.dist  = 90 
proj.doscale      = 1     

[velocity]
