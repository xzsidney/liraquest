trigger1 = command = "holdback"
trigger1 = command !="holdfwd"
trigger1 = vel x > 0
trigger1 = vel y > 0
trigger1 = time > 1
trigger1 = vel x < 0.8
x = -0.3

[state 710, 5]  ; inertial velocity (idle)
