trigger1 = command = "holdback"
trigger1 = command != "holdfwd"
trigger1 = time >= 0
trigger1 = vel x <= 0
trigger1 = vel x > -2.5
x = -0.3

[state 710, 6]  ; Forward inertia
type = veladd
trigger1 = command = "holdfwd"
trigger1 = command !="holdback"
trigger1 = time >= 0
trigger1 = vel x >= 0
trigger1 = vel x < 2.5
x = 0.3
  
