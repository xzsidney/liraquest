trigger1 = command != "holdback"
trigger1 = vel x > 1.5
;trigger1 = vel y > 0
trigger1 = time > 1
x = -0.1

[state 710, 5]  ; inertial velocity (idle)
type = veladd
triggerall = anim != 713
trigger1 = command != "holdfwd"
trigger1 = command != "holdback"
trigger1 = vel x < -1.5
;trigger1 = vel x > 0
trigger1 = time > 1
x = 0.1

[state 710, 6]   ; backward inertia
