;Ending of Wolverine from X-men Vs Street Fighter
;Used Actual ROM, WinKawaks, and PSP
;If you don't like loading scene then
; where it says start scene put 1
; and take out the ; at the music from scene one.
;lupe121283
;www.geocities.com/jose83_83/
;jose83_83@yahoo.com
;no space just hold shift the button next to the zero.
;8/07/02
[SceneDef]
spr = wolverineending.sff
startscene= 0
;------------------------------------
[Scene 1]
; Fade
; Screen color
clearcolor = 0,0,0
; Overlay Anims (from 0 to 9)
layerall.pos = 0,0 ;Default position for all layers
;bg
layer0.anim =  1      ;Anim action number
layer0.starttime = 0
layer0.offset = -32,8
;Pix
layer1.anim =  2      ;Anim action number
layer1.starttime = 0
layer1.offset = 79,40
;dialogue
layer2.anim =  3      ;Anim action number
layer2.starttime = 0
layer2.offset = 0,168
bgm = sound\wolverineend.mp3
bgm.loop = -1
; Total time
end.time = 2600

