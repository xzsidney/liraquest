;---------------------------------------------------------------------------
; HITA_UP (initial going up)
[Statedef 1192]
type    = A
movetype= H
physics = N
ctrl = 0

[State 1192, scb]
type = ScreenBound
Trigger1 = 1
value = 0

[State 1192, Diagupanim]
type = ChangeAnim
trigger1 = time = 0
trigger1 = SelfAnimExist(5052)
value = 5052 

[State 1192, Hitupanim]
type = ChangeAnim
trigger1 = time = 0
trigger1 = !SelfAnimExist(5052) && selfanimexist(5051)
value = 5051

[State 1192, Hitanim]
type = ChangeAnim
trigger1 = time = 0
trigger1 = !SelfAnimExist(5052) && !selfanimexist(5051)
value = 5050

[State 1192, 1]
type = VelAdd;Gravity
trigger1 = 1
y = GetHitVar(yaccel)

[State 1192, 2]
type = HitVelSet
trigger1 = Time = 0
x = 1
y = 1

[State 1192, pos]
type = posadd
trigger1 = Time = 0
y = -15

[State 1192, 4]
type = selfstate
trigger1 = HitOver
trigger2 = Vel Y > 0    ;Hit ground
trigger2 = Pos Y >= 10  ;.
value = 5050 ;HITA_FALL

[State 1192, 5]
type = selfState
trigger1 = AnimTime = 0
value = 5035 ;HITA_UP (transition)

