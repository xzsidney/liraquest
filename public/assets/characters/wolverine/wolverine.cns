trigger1 = prevstateno != 5250
trigger1 = time = 0
trigger1 = var(11) <= 999
trigger1 = gethitvar(animtype) = 0 
var(11) = 50
persistent = 0
ignorehitpause = 1 

[State 5000, DIZZY CODE]
