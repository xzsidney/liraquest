sprpriority = -1
ctrl = 0

[State 5201, snd]
type = PlaySnd
trigger1 = Time = 0
volume = 120
value = 5,3
channel = 0

[State 5201, 1] ;Turn if not facing opponent
type = Turn
trigger1 = Time = 0
