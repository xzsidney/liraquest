;============================
; WOLVERINE X'S BASIC CODING
;============================

[Data]
life = 1000      		      ;Amount of life to start with
attack = 100         		;100% attack power (more is stronger)
defence = 100       	      ;100% defensive power (more is stronger)
fall.defence_up = 90 		;Def goes up by 50% everytime player is hit on ground
liedown.time = 20    		;Time player takes before getting up from HIT_LIEDOWN
airjuggle = 15       		;Can do 15 points of juggling
sparkno = 0          		;Default spark number
guard.sparkno = 0 	      ;Default guard spark number
volume = 100
IntPersistIndex=1
FloatPersistIndex=0
KO.echo = 0 	            ;1 to enable echo on KO
power = 3000

[Size]
xscale = 1  ;.98              ;Horizontal scaling factor.
yscale = 1  ;.98              ;Vertical scaling factor.
ground.back = 26     	     ;Player width (back, ground)
ground.front = 31    	     ;Player width (front, ground)
air.back = 22        	     ;Player width (back, air)
air.front = 25       	     ;Player width (front, air)
z.width = 3          	     ;Player width (into and out)
attack.width = 0    	     ;Default attack width: back, front
attack.dist = 160    	     ;Default attack distance
proj.attack.dist = 90        ;Default attack distance for projectiles
head.pos = 20, -75           ;Approximate position of head
mid.pos = 1, -48             ;Approximate position of midsection

[Velocity]
walk.fwd  = 3.0625           ;Walk forward
walk.back = -3.0625          ;Walk backward
run.fwd  = 10.1667           ;Run forward (x, y)  - if y<0, player will hop
run.back = -9.5,0            ;Run backward (x, y) - if y=0, player will run
jump.neu = 0,-9.05           ;Neutral jumping velocity (x, y)
jump.back = -3.01, -9.05     ;Jump back Speed (x, y)
jump.fwd = 3.01,-9.05        ;Jump forward Speed (x, y)
runjump.fwd = 4.1,-9.7      
airjump.neu = 0,-9.7      
airjump.back = -2.55,-9.7    ;Air jump speeds (opt)
airjump.fwd = 2.5,-9.7    

[Movement]
airjump.num = 0       ;Number of air jumps allowed (opt)
airjump.height = 35   ;Minimum distance from ground before you can air jump (opt)
yaccel = .46          ;Vertical acceleration
stand.friction = .83  ;Friction coefficient when standing
crouch.friction = .82 ;Friction coefficient when crouching

;====================================
;INITIALIZE
[Statedef 5900]
type = S

[State 5900, 1] ;Clear all int variables
type = VarRangeSet
trigger1 = !RoundsExisted
value = 0

[State 5900, 2] ;Clear all float variables
type = VarRangeSet
trigger1 = !RoundsExisted
fvalue = 0

[State 5900, speed]
type = Varset
trigger1 = time = 0
var(19) = 0

[State 5900, 3] ;Intro
type = ChangeState
trigger1 = roundno = 1
value = 188 ;190

[State 5900, Turns Mode Intro]
type = ChangeState
trigger1 = teammode = turns
trigger1 = roundno > 1
trigger1 = roundsexisted <= 0
trigger1 = roundstate = 0
trigger1 = prevstateno != 197
value = 188


;===================================================================================
;---<> OVER WRITE STAND <>---
;============================
; Stand
[Statedef 0]
type = S
physics = S
velset = 0,0
sprpriority = 0

[State 0, AFTER]
type = AfterImage
triggerall = var(19) > 0
trigger1 = time = 0
;trigger1 = prevstateno = [5000,6000]
time = var(19)
ignorehitpause = 1
PalBright = 0, 0, 0
PalContrast =  230,230,230
PalAdd = 0, 0, 0
PalMul = 1,1,1
trans = none
Length = 30
FrameGap = 6

[State 0, scb]
type = varset
trigger1 = backedgebodydist > -20
var(17) = 0

[State 0, 1]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5 && anim != 1
trigger2 = Anim = 5 && AnimTime = 0
trigger3 = anim = 1 && time = 0
value = 0

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

;[State 0, IDLE]
;type = ChangeAnim
;trigger1 = anim != 1
;trigger1 = time = 700
;value = 1

;[State 0, IDLE]
;type = Changestate
;trigger1 = anim = 1
;trigger1 = animtime = 0
;value = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = Abs(Vel x) < 2
trigger2 = Time = 4
x = 0

[State 0, 4] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050

;--------------------------------------------------------------------

; Stand to Crouch
[Statedef 10]
type    = C
physics = C
anim = 10

[State 10, slide]
type = statetypeset
trigger1 = prevstateno = 106 || prevstateno = 100
physics = N

[State 10, slide]
type = velmul
trigger1 = prevstateno = 106 || prevstateno = 100
x = .88

[State 10, slide]
type = velset
trigger1 = time = 0
trigger1 = prevstateno = 106
x = -5

[State 10, slide]
type = velset
trigger1 = prevstateno = 20
x = 0

[State 10, 2]
type = ChangeState
trigger1 = AnimTime = 0
value = 11

;-----------------------------------------------------
; Crouching
[Statedef 11]
type    = C
physics = C
anim = 11
sprpriority = 0

[State 11, slide]
type = velmul
trigger1 = vel x != [0,2]
x = .88

[State 11, slide]
type = velmul
trigger1 = vel x != [0,2]
trigger1 = time >= 8
x = .85

[State 11, slide]
type = statetypeset
trigger1 = vel x != [0,2]
physics = N

[State 11, slide]
type = velset
trigger1 = prevstateno = 20
trigger2 = time >= 10
x = 0

[State 11, 1] ;Change from turning animation
type = ChangeAnim
trigger1 = Anim = 6 && AnimTime = 0
value = 11
;---------------------------------------------------------------------------

; Walk
[Statedef 20]
type    = S
physics = S
sprpriority = 0

[State 20, 1]
type = VelSet
trigger1 = Command = "holdfwd"
trigger1 = var(19) <= 0
x = Const(velocity.walk.fwd.x)

[State 20, 2]
type = VelSet
trigger1 = Command = "holdback"
trigger1 = var(19) <= 0
x = Const(velocity.walk.back.x)

[State 20, 1]
type = VelSet
trigger1 = Command = "holdfwd"
trigger1 = var(19) > 0
x = Const(velocity.walk.fwd.x) + 2

[State 20, 2]
type = VelSet
trigger1 = Command = "holdback"
trigger1 = var(19) > 0
x = Const(velocity.walk.back.x) - 2

[State 20, 3]
type = ChangeAnim
triggerall = Vel x > 0
trigger1 = Anim != 20 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 20

[State 20, 4]
type = ChangeAnim
triggerall = Vel x < 0
trigger1 = Anim != 21 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 21


;-------------------------------------------------------------------
; RUN_FWD
[Statedef 100]
type = S
physics = S
anim = 100
ctrl = 1

[State 100, 1]
type = VelSet
trigger1 = time > 3
trigger1 = var(19) <= 0
x = const(velocity.run.fwd.x)

[State 100, 1]
type = VelSet
trigger1 = time > 3
trigger1 = var(19) > 0
x = const(velocity.run.fwd.x) + 2

[State 100, 1]
type = Ctrlset
trigger1 = var(9) = 1
trigger2 = Command != "holdfwd"
trigger3 = command = "holdup"
trigger4 = command = "holdback"
value = 1

[State 100, Steps]
type = PlaySnd
trigger1 = timemod = 11, 4
value = 1,1
channel = 20

[State 100, voice]
type = PlaySnd
trigger1 = time = 0
value = 5,1
channel = 0

[State 100, 4]
type = ChangeState
trigger1 = animtime = 0
value = 0
ctrl = 1

[State 100, 6]
type = AssertSpecial
trigger1 = command != "holdback"
flag = NoWalk

[State 100, Explod]
type = Explod
trigger1 = time < 18
trigger1 = (time % 4) = 1
scale = const(size.xscale)
ID = 702
anim = 702
postype = p1
pos = -20, -40
random = 20,70
bindtime = 1
removetime = -2
vel = -3, 0
ownpal = 1
random = 20, 60
sprpriority = 2

[State 100, Explod]
type = Explod
trigger1 = time < 18
trigger1 = (time % 4) = 0
scale = const(size.xscale)
ID = 703
anim = 703
postype = p1
pos = -20, -40
random = 20,70
bindtime = 1
removetime = -2
vel = -2.8, 0
ownpal = 1
random = 20, 60
sprpriority = 2
;--------------------------------------------------------

;Hop back (start)
[Statedef 105]
type = S
physics = S
anim = 105
velset = 0
ctrl = 0

[State 105, NOTHITBY]
type = nothitby
trigger1 = 1
value = SC, NT, ST, HT

[State 105, 1]
type = ChangeState
trigger1 = AnimTime = 0
value = 106

;----------------------------

;Hop back (in the air)
[Statedef 106]
type = S
physics = N
anim = 106
ctrl = 1

[State 106, 1]
type = VelSet
trigger1 = Time = 0
trigger1 = var(19) <= 0
x = const(velocity.run.back.x)

[State 106, 1]
type = VelSet
trigger1 = Time = 0
trigger1 = var(19) > 0
x = const(velocity.run.back.x) - 2

[State 106, 1]
type = Velmul
trigger1 = Time >= 8
x = .89

[State 106, 2]
type = PlaySnd
trigger1 = Time = 0
value = 1,2
volume = -50

[State 106, 6]
type = AssertSpecial
trigger1 = command != "holdfwd"
flag = NoWalk

[State 106, voice]
type = PlaySnd
trigger1 = time = 0
value = 5,2
channel = 0

[State 106, 4]
type = ChangeState
trigger1 = animtime = 0
value = 107
ctrl = 1
;---------------------------------

; Dashing back (landing)
[Statedef 107]
type = S
physics = S
anim = 47
velset = 0,0
ctrl = 1

[State 107, 1]
type = PosSet
trigger1 = Time = 0
y = 0

[State 107, 2]
type = PlaySnd
trigger1 = Time = 0
value = 1,5

[State 107, 3]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1
;--------------------------------

;============================
; Overide Common States
;============================
;<><><><<><><><><>>>><><><><<><><<><>><<>><<<>>><<><><<><><><<><<><<<<><><><>>><<<>><><><><
;---------------------------------------------------------------------------
; HIT_FALLRECOVER (still falling)
[Statedef 5200]
type    = A
movetype= H
physics = N

[State 5200, 1] ;Change anim if done with transition
type = ChangeAnim
trigger1 = Anim = 5035
trigger1 = AnimTime = 0
value = 5050

[State 5200, 2]
type = VelAdd
trigger1 = 1
y = GetHitVar(yaccel)

[State 5200, 3]
type = SelfState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 10
value = 5202

;---------------------------------------------------------------------------
; HIT_BOUNCE (hit ground)
[Statedef 5202]
type    = L
movetype= H
physics = N
ctrl = 0

[State 5202, 1]
type = VelSet
trigger1 = Time = 0
trigger1 = GetHitVar(fall.yvel) = 0
trigger1 = Vel x > 1
x = 1

[State 5202, EnvShake]
type = FallEnvShake
trigger1 = Time = 0

[State 5202, 2] ;Hit ground anim (normal)
type = ChangeAnim
triggerall = Time = 0
trigger1 = (anim != [5051,5059]) && (anim != [5061,5069])
trigger2 = !SelfAnimExist(5100 + (anim % 10))
value = 5100

[State 5202, 3] ;Hit ground anim (for hit up)
type = ChangeAnim
trigger1 = Time = 0
trigger1 = (anim = [5051,5059]) || (anim = [5061,5069])
trigger1 = SelfAnimExist(5100 + (anim % 10))
value = 5100 + (anim % 10)

[State 5202, 4]
type = PosSet
trigger1 = Time = 0
y = 0

[State 5202, 5]
type = VelSet
trigger1 = Time = 0
y = 0

[State 5202, 6] ;Reduce speed
type = VelMul
trigger1 = Time = 0
x = 0.75

[State 5202, 8]
type = GameMakeAnim
trigger1 = Time = 1
value = 60 + (SysVar(1) > 5) + (SysVar(1) > 14)
pos = 0, 0
under = SysVar(1) <= 10

[State 5202, 10]
type = PlaySnd
trigger1 = Time = 1
;value = F7, 0 ;Hit ground
value = F7, (SysVar(1) > 5) + (SysVar(1) > 14)

[State 5202, 11]
type = PosFreeze
trigger1 = 1

[State 5202, 12]
type = ChangeState
trigger1 = AnimTime = 0
trigger1 = life <= 0
value = 5101

[State 5202, 12]
type = ChangeState
trigger1 = AnimTime = 0
trigger1 = life > 0
value = 5201

[State 5202, 13]
type = ForceFeedback
trigger1 = Time = 0
waveform = sinesquare
ampl = 128,-3,-.2,.005
time = 20

;------------------------------------------------------------------



;---------------------------------------------------------------------------
