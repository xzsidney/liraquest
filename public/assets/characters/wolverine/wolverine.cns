; Jump Up
[Statedef 50]
type    = A
physics = N

[State 50, dust]
type = Helper
triggerall = time = 0
trigger1 = var(8) = 3
trigger2 = var(8) = -2
trigger3 = var(8) = 2
name = "Dust"
ID = 206
stateno = 206
postype = p1
pos = 0,0
ownpal = 1

[State 50, Vel]
type = VelSet
triggerall = Time = 0
trigger1 = Var(8) = 2
trigger2 = Var(8) = -2
trigger3 = Var(8) = 3
y = -13

[State 50, Neutral]
type = VelSet
trigger1 = Time = 0
trigger1 = Var(8) = 3
x = 0

[State 50, Fwd]
type = VelSet
trigger1 = Time = 0
trigger1 = Var(8) = 2
x = 3.04

[State 50, Back]
type = VelSet
trigger1 = Time = 0
trigger1 = Var(8) = -2
x = -3.04

[State 50, shadow] ; Play sound when jumping (Shadow)
type = PlaySnd
triggerall = Time = 0
trigger1 = var(8) = 3
trigger2 = var(8) = -2
trigger3 = var(8) = 2
value = 1,4
volume = 0

[State 50, CTRL LIMITTER] ;Can't attack after recovery
type = ctrlset
trigger1 = Time = 0
trigger1 = prevstateno = 5040
trigger1 = prevstateno = 5210
value = 0

[State 50, PLAYSND] ; Play sound when jumping (Light)
type = PlaySnd
triggerall = Time = 0
trigger1 = var(8) != -2
trigger2 = var(8) != 2
trigger3 = var(8) != 3
value = 1,3
volume = 0

[State 50, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = var(8) = [-1,1]
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = var(8) != [-1,1]
value = ifelse((vel x)=0, 44, ifelse((vel x)>0, 45, 46))

[State 50, grav]
type = Veladd
trigger1 = var(8) = [-1,1]
trigger1 = time <= 26
y = .385

[State 50, grav 2]
type = Veladd
trigger1 = var(8) = [-1,1]
trigger1 = time > 26
y = .37

[State 50, gravb 1]
type = Veladd
trigger1 = var(8) != [-1,1]
trigger1 = time <= 42
y = .315

[State 50, gravb 2]
type = Veladd
trigger1 = var(8) != [-1,1]
trigger1 = time > 42
y = .255

[State 50, 15]
type = Changestate
trigger1 = vel y > 0 && pos y >= -10
value = 52
ctrl = 0

[State 50, back]
type = veladd
triggerall = vel x >= -3.7
triggerall = command = "holdback"
trigger1 = var(8) = 3
trigger2 = var(8) = -2
trigger3 = var(8) = 2
trigger4 = var(9) = 1
trigger4 = p2bodydist x <= 0
persistent = 4
x = -.9

[State 50, fwd]
type = veladd
triggerall = vel x <= 3.9
triggerall = command = "holdfwd"
trigger1 = var(8) = 3
trigger2 = var(8) = -2
trigger3 = var(8) = 2
trigger4 = var(9) = 1
trigger4 = p2bodydist x <= 0
persistent = 4
x = .9

[State 50, Screen]
type = turn
triggerall = p2dist x < -5
trigger1 = var(8) = 3
trigger2 = var(8) = -2
trigger3 = var(8) = 2
