st3       = wolverineb.cns   		;Gethits
st4       = wolverinec.cns   		;Special Moves
st5       = wolverined.cns   		;Super Moves
;st5      = wolverinedx.cns             ;Super Moves "Without Hyper BGs"
sprite    = wolverine.sff    		;Sprite
anim      = wolverine.air    		;Animation
sound     = logan.snd        		;Sound
pal1      = pal1.act                    ;Palettes
pal2      = pal2.act
pal3      = pal3.act
pal4      = pal4.act
pal5      = pal5.act
pal6      = pal6.act
