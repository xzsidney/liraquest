{
  "name": "liraquest",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:client": "vite",
    "dev:server": "tsx watch server.ts",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:sprites": "npx tsx scripts/generateMugenRegistry.ts",
    "build:client": "npm run build:sprites && vue-tsc -b && vite build",
    "build": "npm run build:client",
    "db:sync": "tsx scripts/syncDatabase.ts",
    "db:seed": "tsx scripts/seedFamilyData.ts",
    "start": "node --loader tsx server.ts",
    "prod": "tsx server.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "axios": "^1.18.1",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.12.0",
    "pinia": "^4.0.3",
    "pixi.js": "^8.20.1",
    "sequelize": "^6.37.5",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.3",
    "sweetalert2": "^11.26.25",
    "tailwindcss": "^4.3.2",
    "vite": "^8.1.1",
    "vue": "^3.5.39",
    "vue-router": "^5.1.0",
    "vue-tsc": "^3.3.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/multer": "^1.4.12",
    "@types/node": "^24.13.2",
    "concurrently": "^9.1.2",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2"
  }
}
